---
import Legal from '../layouts/Legal.astro';
import Ph from '../components/ui/Ph.astro';
import { decisions } from '../site.config';
import { val } from '../lib/env';

/** Terms of Use — DRAFT for the lawyer. Whole text — [review]. */
const email = val(decisions.email);
---

<Legal title="Terms of Use" description="The terms for using this website." page="terms">
  <p>
    This website is operated by <Ph value={decisions.operator.legalName} label="operator" /> (“we”, “us”). By using it, you agree to
    these terms.
  </p>

  <h2>What this site is</h2>
  <p>
    The site describes GoCoding for Business programs and services and publishes practical articles for learning center owners.
    Programs and services are provided under separate agreements with <Ph value={decisions.operator.legalName} label="operator" />; those
    agreements, not this site, set prices, terms and obligations.
  </p>

  <h2>No guaranteed results</h2>
  <p>
    Articles and examples on this site are for general information. They are not legal, financial or professional advice, and
    results in your center depend on many factors. We do not promise specific enrollment or revenue results.
  </p>

  <h2>Content</h2>
  <p>
    Texts, design and materials on this site belong to us or to their authors. You may share links and short quotes with
    attribution. Please do not copy the materials in full without permission.
  </p>

  <h2>Other websites</h2>
  <p>
    Some buttons lead to other websites, such as profitforafterschool.com and our calendar service. Their own terms and privacy
    policies apply there.
  </p>

  <h2>Limitation of liability</h2>
  <p>The site is provided “as is”. To the extent permitted by law, we are not liable for any loss arising from the use of this site.</p>

  <h2>Governing law</h2>
  <p>These terms are governed by the laws of <Ph value={decisions.operator.governingLaw} label="state" />.</p>

  <h2>Contact</h2>
  <p>{email ? <a href={`mailto:${email}`}>{email}</a> : <Ph value={decisions.email} label="email" />}</p>
</Legal>
