---
import Base from '../../layouts/Base.astro';
import Button from '../../components/ui/Button.astro';
import { call } from '../../copy/call';
import { visibleArticles } from '../../lib/articles';
import { isOn } from '../../lib/env';

/**
 * After the /call form (Netlify Forms `action`). Fires booking_completed — now "request sent". Not indexed.
 */
const trialGuide = (await visibleArticles()).find((a) => a.id === 'trial-lesson-step-by-step' && a.data.live);
const b = call.booked;
---

<Base title={b.title} description="Your request for a 15-min call is in." page="call-booked" noindex sticky={false}>
  <section class="mx-auto max-w-[calc(var(--container-measure)+2*var(--page-pad))] px-(--page-pad) py-16 lg:py-28">
    <h1 class="mb-5 text-h1">{b.h1}</h1>
    <p class="mb-8 text-lead text-body">{b.text}</p>
    {
      trialGuide ? (
        <Button href={`/playbook/${trialGuide.id}`} size="lg" icon="arrow">
          Read “{trialGuide.data.title}”
        </Button>
      ) : (
        isOn('bookPage') && (
          <Button href="/book" variant="secondary" size="lg" icon="arrow" cta="call-booked">
            {b.book}
          </Button>
        )
      )
    }
  </section>
</Base>

<script>
  import { incomingUtm, track } from '../../scripts/analytics';

  track('booking_completed', { source: incomingUtm()?.utm_source ?? 'direct' });
</script>
