---
import Legal from '../layouts/Legal.astro';
import Ph from '../components/ui/Ph.astro';
import Pending from '../components/ui/Pending.astro';
import { decisions } from '../site.config';
import { isOn, val } from '../lib/env';

/**
 * Privacy Policy — DRAFT for the lawyer (TZ: operator ArgoPrep Center LLC (GoCoding) [ждёт: юрист];
 * what we collect: call requests, book downloads, analytics; requests are stored by Netlify — decision 28.10).
 * Whole text — [review].
 */
const email = val(decisions.email);
---

<Legal title="Privacy Policy" description="What this website collects, why, and where it goes." page="privacy">
  <p>
    This website is operated by <Ph value={decisions.operator.legalName} label="operator" /> (“we”, “us”). This policy explains what we
    collect when you use the site, why, and who we share it with.
  </p>

  <h2>What we collect</h2>
  <ul>
    <li>
      <strong>Call requests.</strong> When you request a call, we collect your name, your center’s name, your email and phone
      number, and what you need help with. We use them to contact you about your request and our services by email, phone or
      text. You can opt out of texts by replying STOP.
    </li>
    <li>
      <strong>Demo lesson requests.</strong> The “Get a free demo lesson” buttons take you to the GoCoding for Business form on
      profitforafterschool.com. Information you enter there is handled under that site’s privacy policy.
    </li>
    <li>
      <strong>Analytics.</strong> We use Google Analytics to understand how the site is used: pages viewed, buttons clicked, device
      and browser type, approximate location. Google Analytics uses cookies.
    </li>
    <li>
      <strong>Campaign labels.</strong> If you arrive through a link with a campaign label (for example, from Facebook), your browser
      keeps that label for up to 30 days, so we can see which link led to a booking or a demo request.
    </li>
    {
      // Book form (task 03) — appears with /book (flag bookPage). [review] — for the lawyer.
      isOn('bookPage') && (
        <li>
          <Pending flag="bookPage" inline>
            <strong>Book download.</strong> When you download our free book, we collect your email address and phone number. We use
            them to send you the book and to follow up about the book and our services by email, phone or text. You can opt out of
            texts by replying STOP, and ask us to delete your data at any time by writing to{' '}
            {email ? <a href={`mailto:${email}`}>{email}</a> : <Ph value={decisions.email} label="email" />}. We don’t sell your
            personal information.
          </Pending>
        </li>
      )
    }
    <li><strong>Email.</strong> If you write to us, we keep the correspondence.</li>
  </ul>

  <h2>How we use it</h2>
  <p>To schedule and prepare for your call, to reply to you, and to understand which pages and links are useful.</p>

  <h2>Who we share it with</h2>
  <p>
    Requests from the forms on this website are stored by Netlify, our website host. Analytics data is processed by Google.
    We do not sell personal information.
  </p>

  <h2>Children</h2>
  <p>This site is for owners and directors of learning centers. It is not directed to children, and we do not knowingly collect information from children.</p>

  <h2>Your choices</h2>
  <p>
    You can block cookies in your browser or use Google’s opt-out tool for Google Analytics. To ask what we hold about you, or to
    have it deleted, email {email ? <a href={`mailto:${email}`}>{email}</a> : <Ph value={decisions.email} label="email" />}.
  </p>

  <h2>Changes</h2>
  <p>If this policy changes, we will update the date at the top of this page.</p>

  <h2>Contact</h2>
  <p>
    <Ph value={decisions.operator.legalName} label="operator" />{val(decisions.operator.address) ? <>, {decisions.operator.address}</> : null}
    {' · '}
    {email ? <a href={`mailto:${email}`}>{email}</a> : <Ph value={decisions.email} label="email" />}
  </p>
</Legal>
