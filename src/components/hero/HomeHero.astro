---
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Highlight from '../ui/Highlight.astro';
import Photo from '../ui/Photo.astro';
import IntroByline from './IntroByline.astro';
import ProofNote from '../proof/ProofNote.astro';
import { home } from '../../copy/home';
import { demoNote, person } from '../../copy/shared';
import { callUrl, demoUrl } from '../../lib/links';
import { portrait } from '../../lib/photos';
import { showPending } from '../../lib/env';

/**
 * Home hero (boards 08, 09; texts — TZ v1.0).
 * Phone: intro byline → H1 → subtitle → 2 buttons → microcopy → portrait + author intro.
 * Desktop: eyebrow → H1 → … ; portrait 4:5 on the right with the name plate, author intro below it.
 * "Alex Key" stands out only here (TZ «Имя», DESIGN §6.6).
 */
const hasPortrait = Boolean(portrait.src) || showPending;
---

<section data-hero aria-labelledby="hero-title" class="bg-paper">
  <div
    class="mx-auto grid max-w-[calc(var(--container-site)+2*var(--page-pad))] gap-11 px-(--page-pad) pt-5.5 pb-11 lg:grid-cols-[minmax(0,1fr)_400px] lg:items-center lg:gap-20 lg:pt-20 lg:pb-24"
  >
    <div class="flex flex-col gap-5 lg:gap-7">
      <IntroByline class="lg:hidden" />
      <Eyebrow class="hidden lg:flex">{home.eyebrow}</Eyebrow>
      <h1 id="hero-title" class="text-h1">
        {home.h1.before}<Highlight>{home.h1.key}</Highlight>{home.h1.after}
      </h1>
      <p class="max-w-[38rem] text-[18px] leading-[1.55] text-body lg:text-lead">{home.subtitle}</p>
      <div class="flex flex-col gap-3 pt-1 lg:flex-row lg:items-center lg:gap-4">
        <Button href={demoUrl('home', 'hero')} size="lg" icon="arrow" cta="home-hero" class="w-full lg:w-auto">
          Get a free demo lesson
        </Button>
        <Button href={callUrl('home', 'hero')} variant="secondary" size="lg" cta="home-hero" class="w-full lg:w-auto">
          Book a 15-min call
        </Button>
      </div>
      <p class="text-center text-small text-slate lg:-mt-2 lg:text-left">{demoNote}</p>
    </div>

    <div class="flex flex-col gap-4">
      {
        hasPortrait && (
          <Photo
            src={portrait.src}
            alt={portrait.alt}
            ratio="4/5"
            label="Portrait 4:5 · real photo"
            sizes="(min-width: 1024px) 400px, calc(100vw - 40px)"
            widths={[400, 600, 800]}
          >
            <div class="absolute inset-x-4 bottom-4 hidden rounded-tip bg-paper px-4 py-3 lg:block">
              <p class="text-[17px] font-bold text-ink">{person.name}</p>
              <p class="text-[14px] leading-snug text-slate">
                {person.role} · {person.org}, {person.city}
              </p>
            </div>
          </Photo>
        )
      }
      <p class="text-[16px] leading-normal text-body">
        {home.intro} <ProofNote />
      </p>
      {portrait.caption && <p class="text-[14px] text-slate">{portrait.caption}</p>}
    </div>
  </div>
</section>
