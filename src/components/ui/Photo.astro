---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { showPending } from '../../lib/env';

/**
 * Real photo only (board 04). Until it arrives — placeholder in local builds,
 * nothing in public builds (no stubs on the site).
 */
interface Props {
  src: ImageMetadata | null;
  alt: string;
  ratio?: '4/5' | '3/2' | '16/9';
  caption?: string | null;
  /** Placeholder label, e.g. "Portrait 4:5 · real photo". */
  label?: string;
  widths?: number[];
  sizes?: string;
  priority?: boolean;
  class?: string;
  /** Slot content overlays the photo (e.g. name plate on desktop hero); slot "caption" replaces `caption`. */
  overlay?: boolean;
}
const {
  src,
  alt,
  ratio = '4/5',
  caption,
  label = 'Real photo',
  widths = [360, 480, 720, 960],
  sizes = '(min-width: 1024px) 400px, calc(100vw - 40px)',
  priority = false,
  class: className,
} = Astro.props;
const aspect = { '4/5': 'aspect-[4/5]', '3/2': 'aspect-[3/2]', '16/9': 'aspect-video' }[ratio];
const show = Boolean(src) || showPending;
---

{
  show && (
    <figure class:list={['flex flex-col gap-3', className]}>
      <div class:list={['relative overflow-hidden rounded-card bg-placeholder', aspect]}>
        {src ? (
          <Picture
            src={src}
            alt={alt}
            formats={['avif', 'webp']}
            widths={widths}
            sizes={sizes}
            loading={priority ? 'eager' : 'lazy'}
            fetchpriority={priority ? 'high' : 'auto'}
            class="size-full object-cover"
          />
        ) : (
          <>
            <svg viewBox="0 0 300 375" preserveAspectRatio="xMidYMax meet" aria-hidden="true" class="absolute inset-0 size-full text-line">
              <circle cx="150" cy="150" r="54" fill="currentColor" />
              <path d="M44 375c8-78 50-120 106-120s98 42 106 120z" fill="currentColor" />
            </svg>
            <span class="absolute top-3.5 left-3.5 rounded bg-paper px-2 py-1 text-[12px] font-bold text-ink">{label}</span>
          </>
        )}
        <slot />
      </div>
      {Astro.slots.has('caption') ? (
        <figcaption>
          <slot name="caption" />
        </figcaption>
      ) : (
        caption && <figcaption class="text-[14px] leading-snug text-slate">{caption}</figcaption>
      )}
    </figure>
  )
}
