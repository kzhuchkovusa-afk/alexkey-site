---
/** Path steps (boards 05, 06): 3 steps on Mist, step 1 is the next step → Key. */
interface Props {
  steps: { title: string; sub?: string }[];
  label?: string;
}
const { steps, label = 'How to start' } = Astro.props;
---

<ol aria-label={label} class="grid overflow-hidden rounded-card bg-mist md:grid-cols-3">
  {
    steps.map((s, i) => (
      <li class:list={['flex items-center gap-3.5 px-5 py-4.5 lg:px-6.5 lg:py-5.5', i > 0 && 'border-t border-line md:border-t-0 md:border-l']}>
        <span
          aria-hidden="true"
          class:list={[
            'tabular flex size-9 shrink-0 items-center justify-center text-[17px] font-extrabold',
            i === 0 ? 'bg-key text-ink' : 'bg-ink text-paper',
          ]}
        >
          {i + 1}
        </span>
        <span class="flex flex-col gap-0.5">
          <span class="text-[18px] leading-snug font-bold text-ink">
            <span class="sr-only">Step {i + 1}: </span>
            {s.title}
          </span>
          {s.sub && <span class="text-[15px] text-slate">{s.sub}</span>}
        </span>
      </li>
    ))
  }
</ol>
