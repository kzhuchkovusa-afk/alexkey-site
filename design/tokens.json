{
  "$description": "Alex Key design tokens v1.1 (Oct 24, 2026). Same values as design/theme.css. Use for Facebook post cards, OG images and any non-Tailwind tool.",
  "color": {
    "paper":        { "$value": "#FFFFFF", "$description": "60% — page and card background" },
    "mist":         { "$value": "#F1F3F6", "$description": "20% — alternating sections, panels" },
    "ink":          { "$value": "#0F1F38", "$description": "15% — headings, proof band, CTA ribbon, footer" },
    "ink-2":        { "$value": "#1B2E4F", "$description": "raised dark surfaces" },
    "body":         { "$value": "#2F3D56", "$description": "body text on light" },
    "slate":        { "$value": "#55627A", "$description": "captions, meta" },
    "line":         { "$value": "#DCE1E8", "$description": "decorative borders, dividers" },
    "field-line":   { "$value": "#7D889C", "$description": "input and chip borders (3.6:1)" },
    "on-ink-muted": { "$value": "#AAB6CB", "$description": "secondary text on ink" },
    "ink-line":     { "$value": "#2C3F5F", "$description": "dividers on ink" },
    "key":          { "$value": "#F5A524", "$description": "KEY (amber, recommended). Coral alternative #F0705A" },
    "key-press":    { "$value": "#E0901A", "$description": "hover / pressed key" },
    "key-tint":     { "$value": "#FDF1D8", "$description": "guarantee plate" },
    "success":      { "$value": "#1E7A52", "$description": "forms only" },
    "error":        { "$value": "#B42318", "$description": "forms only" },
    "placeholder":  { "$value": "#E8EDF4", "$description": "image placeholders" }
  },
  "font": {
    "family": { "$value": "Schibsted Grotesk", "$description": "Variable 400–900, latin, OFL. Headings 800, body 400, UI 700" }
  },
  "type": {
    "display": { "mobile": 72, "desktop": 160, "weight": 800, "lineHeight": 0.9,  "letterSpacing": "-0.04em" },
    "h1":      { "mobile": 38, "desktop": 72,  "weight": 800, "lineHeight": 1.05, "letterSpacing": "-0.03em" },
    "h2":      { "mobile": 30, "desktop": 48,  "weight": 800, "lineHeight": 1.1,  "letterSpacing": "-0.025em" },
    "h3":      { "mobile": 22, "desktop": 28,  "weight": 700, "lineHeight": 1.25, "letterSpacing": "-0.015em" },
    "lead":    { "mobile": 20, "desktop": 24,  "weight": 400, "lineHeight": 1.5,  "letterSpacing": "-0.005em" },
    "body":    { "mobile": 18, "desktop": 20,  "weight": 400, "lineHeight": 1.6,  "letterSpacing": "0" },
    "ui":      { "mobile": 17, "desktop": 18,  "weight": 700, "lineHeight": 1,    "letterSpacing": "-0.005em" },
    "small":   { "mobile": 15, "desktop": 16,  "weight": 400, "lineHeight": 1.5,  "letterSpacing": "0" },
    "caption": { "mobile": 13, "desktop": 14,  "weight": 500, "lineHeight": 1.4,  "letterSpacing": "0.005em" }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64, "9": 96, "10": 128 },
  "layout": {
    "container": 1200, "measure": 640,
    "pagePad": { "mobile": 20, "desktop": 32 },
    "sectionY": { "mobile": 64, "desktop": 128 },
    "gutter": { "mobile": 16, "desktop": 24 },
    "columns": { "mobile": 4, "desktop": 12 },
    "breakpoints": { "base": 390, "md": 768, "lg": 1024, "xl": 1440 }
  },
  "radius": { "key": 0, "control": 6, "tip": 8, "card": 12, "avatar": "50%" },
  "shadow": { "float": "0 1px 2px rgba(15,31,56,.06), 0 12px 32px rgba(15,31,56,.14)" },
  "size": { "buttonLg": 56, "buttonMd": 52, "buttonSm": 44, "touchMin": 44 },
  "motion": { "fast": "150ms", "base": "240ms", "reducedMotion": "0ms" }
}
